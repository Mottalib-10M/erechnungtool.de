---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'de';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'pflicht-check', h2: 'Pflicht-Check', text: 'Drei Angaben, und Ihre Leser sehen, ab wann sie E-Rechnungen ausstellen müssen und was schon heute gilt.', t: 'E-Rechnungspflicht prüfen', h: 760 },
  { name: 'leitweg-id', h2: 'Leitweg-ID-Prüfer', text: 'Prüft Aufbau, Bereich und Prüfziffer einer Leitweg-ID, bevor eine Rechnung an eine Behörde geht.', t: 'Leitweg-ID prüfen', h: 520 },
  { name: 'e-rechnung-viewer', h2: 'E-Rechnung-Viewer', text: 'Öffnet XRechnung und ZUGFeRD als lesbare Rechnung. Die Datei bleibt auf dem Gerät Ihrer Leser.', t: 'E-Rechnung öffnen', h: 1200 },
];
---
<PageLayout title="E-Rechnung-Werkzeuge kostenlos einbinden: Check, Leitweg-ID, Viewer" description="Pflicht-Check, Leitweg-ID-Prüfer und Viewer für XRechnung und ZUGFeRD kostenlos per iframe einbinden: Code kopieren, neue Fassungen kommen von selbst." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Start', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Werkzeuge zur E-Rechnung einbinden</h1>
    <p class="mt-3 text-lg text-navy-700">Für Kammern, Verbände, Kanzleien und Vereine: einmal kopieren, neue Fristen und Formatversionen erscheinen von selbst.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>Für die englische Fassung ersetzen Sie <code>/embed/de/</code> durch <code>/embed/en/</code>. Bedingungen: Der Quellenlink unter dem Werkzeug bleibt sichtbar, das Werkzeug wird nicht verändert und ohne Gewähr bereitgestellt. Was Ihre Leser eingeben oder öffnen, bleibt auf deren Gerät. Fragen über die <a href={route('contact', lang)}>Kontaktseite</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/pflicht-check/`} title="E-Rechnungspflicht prüfen" width="100%" height="760" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
