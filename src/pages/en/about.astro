---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL, SITE_NAMES } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { KIT as K } from '../../lib/kit';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const path = route('about', lang);
const title = 'E-Rechnung-Check Publisher 2026: Who We Are, Our Sources';
const description = 'E-Rechnung-Check 2026 is published by Radif Partners: independent, free tools for XRechnung and ZUGFeRD that run in your browser, no account and no upload.';
const s = (k: string, t: string) => srcLink(k, lang, t);
const S = K.P.standards;
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'About', path }])]} breadcrumbs={[{ label: 'About' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>About {SITE_NAMES[lang]}</h1>
    <p>{AUTHOR_DESC.en}</p>
    <h2>Why this site exists</h2>
    <p>With the German e-invoicing mandate, many small businesses face a file they cannot read and a duty whose stages are hard to follow. Many offers on the subject are part of software you are expected to buy, require an account or upload invoices containing customer data to third-party servers. This site aims for the opposite: settle the mandate in a minute, and open, check and create files without any invoice leaving your device.</p>
    <h2>Who publishes it</h2>
    <p>The publisher is {AUTHOR_NAME}, a company that builds tools from public rules and data. {AUTHOR_NAME} is not an authority, a tax adviser or a law firm. The site is not affiliated with the Federal Ministry of Finance, KoSIT, the German e-invoicing forum FeRD or any software vendor, and uses none of their logos. It sells no software, contains no affiliate links and is funded by advertising at the edge of the pages.</p>
    <LegalIdentity lang={lang} />
    <h2>Where the rules and formats come from</h2>
    <p>The mandate and its exceptions come from the <Fragment set:html={s('ustg14', 'VAT Act')} />, the VAT Implementing Ordinance and the <Fragment set:html={s('bmf-2025', 'Finance Ministry letter of 15 October 2025')} />. The formats follow the specifications of <Fragment set:html={s('kosit-xrechnung', 'KoSIT')} /> for XRechnung {S.xrechnung} and of <Fragment set:html={s('ferd', 'FeRD')} /> for ZUGFeRD {S.zugferd}. We checked generated files with the official KoSIT validator and with veraPDF. How we calculate and check is on the <a href={route('method', lang)}>method</a> page; how we correct, in the <a href={route('editorial', lang)}>editorial policy</a>.</p>
    <h2>Your data</h2>
    <p>The tools process invoices only in your browser. There is no account, no form that sends invoice data to us and no storage for your files. Details on audience measurement are in the <a href={route('privacy', lang)}>privacy policy</a>.</p>
    <h2>What the site does not do</h2>
    <p>It does not deliver invoices for you, does not replace bookkeeping and gives no tax advice. The results rest on statute and standard; whether an invoice is proper in your individual case is for your tax adviser and the tax office to judge.</p>
    <h2>Write to us</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, if you notice a wrong rule, an outdated deadline or a file the viewer reads incorrectly.</p>
  </article>
</PageLayout>
